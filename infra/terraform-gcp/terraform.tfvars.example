# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is git-ignored — never commit real secrets.

# --- Required ---
project_id      = "oneclick-erp-123456"           # your GCP project ID
admin_cidr      = "203.0.113.10/32"               # your public IP (curl ifconfig.me)
github_repo_url = "https://github.com/YourUser/OneClick-ERP.git"
notification_email = "you@example.com"

# --- GitHub (leave empty for public repos) ---
# github_token = "ghp_xxxxxxxxxxxx"

# --- SMTP for release emails (GCP blocks port 25 — use port 587) ---
# For Gmail: generate an App Password at myaccount.google.com/apppasswords
smtp_host     = "smtp.gmail.com"
smtp_port     = 587
smtp_user     = "you@gmail.com"
smtp_password = "xxxx xxxx xxxx xxxx"             # 16-char Gmail app password

# --- HTTPS (optional but recommended) ---
# Set app_domain and Caddy gets a free Let's Encrypt certificate automatically,
# serves HTTPS on 443 and redirects HTTP to it.
#
# Before running apply, point the domain's A record at the app's static IP.
# Get the IP from `terraform output app_ip` after the first apply, add the DNS
# record, then set app_domain here and apply again.
#
# Leave it empty to serve plain HTTP on the IP (fine for a demo, not for real use).
# app_domain = "erp.example.com"
# acme_email = "you@example.com"          # defaults to notification_email

# --- Database backups ---
# A daily pg_dump is uploaded to gs://<project_id>-db-backups and deleted after
# this many days. Restore with: sudo /opt/erp/db-restore.sh
backup_retention_days = 30

# --- GCP region/zone ---
region = "us-central1"
zone   = "us-central1-a"

# --- Vertex AI (Claude) ---
vertex_model_id = "claude-opus-4-5"
vertex_region   = "us-east5"                      # Claude available in us-east5 and europe-west1

# --- GitHub webhook ranges (same as AWS side) ---
github_webhook_cidrs = [
  "192.30.252.0/22",
  "185.199.108.0/22",
  "140.82.112.0/20",
  "143.55.64.0/20",
]

# --- VM sizes (smaller = cheaper; Jenkins needs e2-medium for builds) ---
jenkins_machine_type = "e2-medium"
app_machine_type     = "e2-small"
