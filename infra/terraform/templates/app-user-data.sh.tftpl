#!/bin/bash
# App server first boot: Docker + Compose, config files, start PostgreSQL.
# The app container itself is started by the first pipeline deploy.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

COMPOSE_VERSION=v2.32.4
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/erp
cd /opt/erp
echo '${compose_b64}' | base64 -d > docker-compose.yml
echo '${deploy_b64}'  | base64 -d > deploy.sh
chmod 750 deploy.sh

DB_PASSWORD=$(aws ssm get-parameter --region ${aws_region} --name "${db_param_name}" --with-decryption --query Parameter.Value --output text)
umask 077
cat > .env <<EOF
AWS_REGION=${aws_region}
LOG_GROUP=${log_group}
DB_PASSWORD=$DB_PASSWORD
APP_IMAGE=
EOF

docker compose up -d db
echo "App server ready. Waiting for the first deploy from Jenkins."
